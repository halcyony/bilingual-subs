# Copy to .env and fill in. Any provider without a key is skipped.

# https://www.opensubtitles.com/en/consumers  (create an API consumer)
OPENSUBTITLES_API_KEY=
# Optional: logging in raises the daily download quota
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# https://subdl.com/panel/api
SUBDL_API_KEY=

# https://assrt.net/usercp.php  (API token)
ASSRT_TOKEN=

# Optional
# ALASS_PATH=   (default: tools/alass/alass-cli.exe in this folder)
# MAX_DOWNLOADS_PER_PROVIDER=4
# MAX_OPENSUBTITLES_DOWNLOADS=1
# CACHE_DIR=cache
# USER_AGENT=stremio-bilingual-subs v0.1.0

# --- Add-on server ---
# Name the subtitle is listed under (Nuvio files "Chinese-English" under Chinese)
SUBTITLE_LANG=Chinese-English
# PORT=7000
# HOST=0.0.0.0
# Public https address behind Pangolin, e.g. https://subs.example.com
# PUBLIC_URL=
# Secret path segment; install URL becomes PUBLIC_URL/<ADDON_TOKEN>/manifest.json
# ADDON_TOKEN=
# Folder for cache/, results/, logs/ (Docker: /data)
# DATA_DIR=
