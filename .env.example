# Copy to .env and fill in. Any provider without a key is skipped.

# https://www.opensubtitles.com/en/consumers  (create an API consumer)
OPENSUBTITLES_API_KEY=
# Optional: logging in raises the daily download quota
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# https://subdl.com/panel/api
SUBDL_API_KEY=

# https://assrt.net/usercp.php  (API token)
ASSRT_TOKEN=

# Optional: https://sub.wyzie.io  (free key: 1,000 requests a day)
WYZIE_API_KEY=

# Optional: https://subsource.net  (API key from your account)
SUBSOURCE_API_KEY=

# Optional: machine translation when no Chinese subtitle exists anywhere
# (Chinese-original titles too). DeepL first, Claude when DeepL runs out.
# https://www.deepl.com/pro-api  (free Developer plan: 1,000,000 characters once)
DEEPL_API_KEY=
# https://platform.claude.com  (API key; billed separately from a Claude plan)
ANTHROPIC_API_KEY=
# TRANSLATE_MODEL=claude-haiku-5-5

# Optional
# ALASS_PATH=   (default: tools/alass/alass-cli.exe in this folder)
# MAX_DOWNLOADS_PER_PROVIDER=4
# MAX_OPENSUBTITLES_DOWNLOADS=1
# MAX_SUBDL_DOWNLOADS=3
# CACHE_MAX_AGE_DAYS=30
# RESULTS_MAX_AGE_DAYS=60
# CACHE_DIR=cache
# USER_AGENT=   (default: stremio-bilingual-subs v<version from package.json>)
# MAX_DOWNLOAD_BYTES=31457280   (larger downloads are refused)
# MAX_SUBTITLE_BYTES=5242880    (larger files inside an archive are skipped)
# TO_SIMPLIFIED=false   (keep a Traditional Chinese result as it is)

# --- Add-on server ---
# Name the subtitle is listed under (Nuvio files "Chinese-English" under Chinese)
SUBTITLE_LANG=Chinese-English
# PORT=7000
# HOST=0.0.0.0
# Public https address behind Pangolin, e.g. https://subs.example.com
# PUBLIC_URL=
# Secret path segment; install URL becomes PUBLIC_URL/<ADDON_TOKEN>/manifest.json
# ADDON_TOKEN=
# Folder for cache/, results/, logs/ (Docker: /data)
# DATA_DIR=
